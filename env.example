# Contraseña que se pedirá para entrar en la app (elige la que quieras)
APP_PASSWORD=cambia-esto

# Credenciales de tu base de datos en Turso (turso.tech)
# Las obtienes al crear la base de datos con la CLI de Turso, ver README.md
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=el-token-que-te-da-turso

# Puerto (Render lo asigna solo, no lo toques en producción)
PORT=3000
